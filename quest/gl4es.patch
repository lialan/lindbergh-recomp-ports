index 0000000..f812ec3
--- /dev/null
+++ b/src/gl/multiview.c
@@ -0,0 +1,611 @@
+// multiview.c - both eyes of a VR headset in one pass (see multiview.h).
+//
+// Shaders: what gl4es makes of every shader is GLSL ES 1.00, and multiview
+// needs 3.00. The step between them is small and textual - attribute and
+// varying become in and out, the texture2D family becomes texture, the
+// fragment colour a declared output - so it is done on the finished text.
+// A vertex shader's main() is renamed and called from a new one, which takes
+// gl_Position to the view's clip space with that view's matrix, and writes
+// four clip distances that hold it inside the game's screen (-1..1 in the
+// game's clip space, a third matrix away) when the host enables them.
+// A vertex program that already does its own per-view step (arbprog.c in
+// the lindbergh runtime, which declares u_reproj) leaves the game's clip
+// position in gl4es_mvPre instead.
+//
+// Rectangle textures: each one attached to a framebuffer gets a companion
+// GL_TEXTURE_2D_ARRAY of two layers, attached in its place for both views
+// at once, and bound beside it on every unit the rectangle texture is bound
+// to. Shaders sample rectangle units as sampler2DArray at the view's layer
+// (fpe_shader.c, and the runtime's ARB translation).
+
+#include <stdio.h>
+#include <time.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+
+#include "multiview.h"
+
+#include "../glx/hardext.h"
+#include "gl4es.h"
+#include "glstate.h"
+#include "loader.h"
+#include "string_utils.h"
+
+#define GL_TEXTURE_2D_ARRAY_    0x8C1A
+#define GL_UNIFORM_BUFFER_      0x8A11
+#define GL_UNIFORM_BUFFER_OFFSET_ALIGNMENT_ 0x8A34
+#define GL_DYNAMIC_DRAW_        0x88E8
+#define GL_DEPTH24_STENCIL8_    0x88F0
+#define GL_RGBA8_               0x8058
+#define GL_CLIP_DISTANCE0_      0x3000
+#define GL_INVALID_INDEX_       0xFFFFFFFFu
+#ifndef GL_MIRRORED_REPEAT
+#define GL_MIRRORED_REPEAT      0x8370
+#endif
+#define MV_BINDING 7            // the uniform buffer binding the views' matrices use
+#define MV_UNITS 16
+
+int gl4es_mv = 0;
+int gl4es_mv_shaders = 0;
+int gl4es_mv_trace = 0;         // set by the host: report what each draw binds
+static const char* mv_dump;     // LIBGL_MV_DUMP=<dir>: every converted shader written there
+
+static struct {
+    void (*TexStorage3D)(GLenum, GLsizei, GLenum, GLsizei, GLsizei, GLsizei);
+    void (*TexImage3D)(GLenum, GLint, GLint, GLsizei, GLsizei, GLsizei, GLint, GLenum, GLenum, const void*);
+    void (*GenFramebuffers)(GLsizei, GLuint*);
+    void (*DeleteFramebuffers)(GLsizei, const GLuint*);
+    void (*BindFramebuffer)(GLenum, GLuint);
+    void (*FramebufferTextureLayer)(GLenum, GLenum, GLuint, GLint, GLint);
+    void (*BlitFramebuffer)(GLint, GLint, GLint, GLint, GLint, GLint, GLint, GLint, GLbitfield, GLenum);
+    void (*FramebufferTexture2D)(GLenum, GLenum, GLenum, GLuint, GLint);
+    GLboolean (*IsEnabled)(GLenum);
+    void (*ReadPixels)(GLint, GLint, GLsizei, GLsizei, GLenum, GLenum, void*);
+    void (*TexSubImage3D)(GLenum, GLint, GLint, GLint, GLint, GLsizei, GLsizei, GLsizei, GLenum, GLenum, const void*);
+    void (*FramebufferTextureMultiviewOVR)(GLenum, GLenum, GLuint, GLint, GLint, GLsizei);
+    GLuint (*GetUniformBlockIndex)(GLuint, const GLchar*);
+    void (*UniformBlockBinding)(GLuint, GLuint, GLuint);
+    void (*BindBufferRange)(GLenum, GLuint, GLuint, GLintptr, GLsizeiptr);
+    void (*GenBuffers)(GLsizei, GLuint*);
+    void (*BindBuffer)(GLenum, GLuint);
+    void (*BufferData)(GLenum, GLsizeiptr, const void*, GLenum);
+    void (*BufferSubData)(GLenum, GLintptr, GLsizeiptr, const void*);
+    void* (*MapBufferRange)(GLenum, GLintptr, GLsizeiptr, GLbitfield);
+    void (*BufferStorageEXT)(GLenum, GLsizeiptr, const void*, GLbitfield);
+    GLboolean (*UnmapBuffer)(GLenum);
+    void (*GenTextures)(GLsizei, GLuint*);
+    void (*DeleteTextures)(GLsizei, const GLuint*);
+    void (*BindTexture)(GLenum, GLuint);
+    void (*ActiveTexture)(GLenum);
+    void (*TexParameteri)(GLenum, GLenum, GLint);
+    void (*GetIntegerv)(GLenum, GLint*);
+    void (*Enable)(GLenum);
+    void (*Disable)(GLenum);
+    const GLubyte* (*GetString)(GLenum);
+    GLenum (*GetError)(void);
+    void* (*FenceSync)(GLenum, GLbitfield);
+    GLenum (*ClientWaitSync)(void*, GLbitfield, GLuint64);
+    void (*DeleteSync)(void*);
+} mv;
+static int mv_check = -1;       // LIBGL_MV_CHECK=1: report GL errors met before draws
+
+int gl4es_multiview_enable(void)
+{
+    if(gl4es_mv) return 1;
+#define L(n) if(!(*(void**)&mv.n = proc_address(gles, "gl" #n))) { printf("LIBGL: multiview: no gl%s\n", #n); return 0; }
+    L(GetString)
+    const char* ext = (const char*)mv.GetString(GL_EXTENSIONS);
+    { const char* v = getenv("LIBGL_MV_CHECK"); mv_check = v && *v == '1'; }
+    mv_dump = getenv("LIBGL_MV_DUMP");
+    if(mv_dump && !*mv_dump) mv_dump = NULL;
+    if(mv_dump) mkdir(mv_dump, 0755);
+    if(!ext || !strstr(ext, "GL_OVR_multiview2") || !strstr(ext, "GL_EXT_clip_cull_distance")) {
+        printf("LIBGL: multiview: the driver has no GL_OVR_multiview2 or GL_EXT_clip_cull_distance\n");
+        // for checking the shaders elsewhere: made, written out, and not drawn with
+        if(mv_dump) { gl4es_mv_shaders = 1; printf("LIBGL: multiview: shaders only, written to %s\n", mv_dump); }
+        return 0;
+    }
+    L(TexStorage3D) L(FramebufferTextureMultiviewOVR) L(GetUniformBlockIndex) L(UniformBlockBinding)
+    L(BindBufferRange) L(GenBuffers) L(BindBuffer) L(BufferData) L(BufferSubData) L(MapBufferRange) L(UnmapBuffer) L(GenTextures)
+    L(DeleteTextures) L(BindTexture) L(ActiveTexture) L(TexParameteri) L(GetIntegerv) L(Enable) L(Disable)
+    L(TexImage3D) L(TexSubImage3D) L(FenceSync) L(ClientWaitSync) L(DeleteSync)
+    L(GetError) L(BlitFramebuffer) L(FramebufferTexture2D) L(IsEnabled) L(GenFramebuffers) L(DeleteFramebuffers) L(BindFramebuffer) L(FramebufferTextureLayer) L(ReadPixels)
+#undef L
+    if(strstr(ext, "GL_EXT_buffer_storage")) *(void**)&mv.BufferStorageEXT = proc_address(gles, "glBufferStorageEXT");
+    gl4es_mv = gl4es_mv_shaders = 1;
+    return 1;
+}
+
+// ********* the views' matrices *********
+// A ring of slots in one buffer. Each new set of matrices is written once,
+// twice over - not clipping, then clipping - into the next two slots through
+// an unsynchronised mapping; clipping on and off then only moves the
+// binding. Rewriting a buffer the GPU still reads with glBufferSubData made
+// the driver copy or wait on every 2D draw. The ring is cut into segments,
+// each closed with a fence when left: writing into a segment first waits on
+// its fence, so the ring can never overwrite matrices still being drawn with
+// (the game sets about 25 a frame, so in practice it never waits).
+#define MV_SLOTS 16384
+#define MV_SEGS 16
+static GLuint mv_ubo;
+static int mv_stride, mv_slot = -2;
+static void* mv_fence[MV_SEGS];
+static unsigned mv_waits;
+static struct { float m[3][16]; float clip[4]; } mv_block;
+static int mv_have, mv_clip;
+
+static char* mv_mapped;     // the whole ring, mapped once for good (GL_EXT_buffer_storage)
+
+static void mv_bind_slot(int clip)
+{
+    mv.BindBufferRange(GL_UNIFORM_BUFFER_, MV_BINDING, mv_ubo, (GLintptr)(mv_slot + clip) * mv_stride, sizeof(mv_block));
+}
+
+void gl4es_multiview_set(const float m[3][16], int clip)
+{
+    if(!gl4es_mv) return;
+    int same = mv_have && !memcmp(m, mv_block.m, sizeof(mv_block.m));
+    if(same && clip == mv_clip) return;
+    if(clip != mv_clip) {
+        for(int i=0; i<4; i++) (clip ? mv.Enable : mv.Disable)(GL_CLIP_DISTANCE0_ + i);
+        mv_clip = clip;
+    }
+    if(same) { mv_bind_slot(clip); return; }
+    if(!mv_ubo) {
+        GLint align = 256;
+        mv.GetIntegerv(GL_UNIFORM_BUFFER_OFFSET_ALIGNMENT_, &align);
+        if(align < 1) align = 256;
+        mv_stride = ((int)sizeof(mv_block) + align - 1) / align * align;
+        mv.GenBuffers(1, &mv_ubo);
+        mv.BindBuffer(GL_UNIFORM_BUFFER_, mv_ubo);
+        // mapped once, persistent and coherent: mapping a slot for each new set
+        // of matrices cost ~100 us on the Quest's driver, every projection
+        if(mv.BufferStorageEXT && !getenv("LIBGL_MV_NOPERSIST")) {
+            GLsizeiptr size = (GLsizeiptr)mv_stride * MV_SLOTS + sizeof(mv_block);
+            mv.BufferStorageEXT(GL_UNIFORM_BUFFER_, size, NULL, 0x0002 | 0x0040 | 0x0080 /*WRITE, PERSISTENT, COHERENT*/);
+            mv_mapped = mv.MapBufferRange(GL_UNIFORM_BUFFER_, 0, size, 0x0002 | 0x0040 | 0x0080);
+            printf("LIBGL: multiview: matrix ring %s\n", mv_mapped ? "mapped for good" : "could not be mapped");
+        }
+        if(!mv_mapped) mv.BufferData(GL_UNIFORM_BUFFER_, (GLsizeiptr)mv_stride * MV_SLOTS, NULL, GL_DYNAMIC_DRAW_);
+    }
+    memcpy(mv_block.m, m, sizeof(mv_block.m));
+    mv_have = 1;
+    int seg_len = MV_SLOTS / MV_SEGS, prev = mv_slot;
+    mv_slot = (mv_slot + 2) % MV_SLOTS;
+    if(prev < 0 || mv_slot / seg_len != prev / seg_len) {
+        if(prev >= 0) mv_fence[prev / seg_len] = mv.FenceSync(0x9117 /*GL_SYNC_GPU_COMMANDS_COMPLETE*/, 0);
+        void** f = &mv_fence[mv_slot / seg_len];
+        if(*f) {
+            if(mv.ClientWaitSync(*f, 0, 0) == 0x911B /*GL_TIMEOUT_EXPIRED*/) {
+                mv.ClientWaitSync(*f, 0x1 /*FLUSH_COMMANDS*/, 1000000000ull);
+                if(!(mv_waits++ & 63)) fprintf(stderr, "LIBGL: multiview: matrix ring waited on the GPU (%u times)\n", mv_waits);
+            }
+            mv.DeleteSync(*f); *f = NULL;
+        }
+    }
+    if(mv_mapped) {
+        for(int c = 0; c < 2; c++) {
+            mv_block.clip[0] = (float)c;
+            memcpy(mv_mapped + (mv_slot + c) * mv_stride, &mv_block, sizeof(mv_block));
+        }
+        mv_bind_slot(clip);
+        return;
+    }
+    mv.BindBuffer(GL_UNIFORM_BUFFER_, mv_ubo);
+    char* p = mv.MapBufferRange(GL_UNIFORM_BUFFER_, (GLintptr)mv_slot * mv_stride, mv_stride + sizeof(mv_block),
+                                0x0002 /*WRITE*/ | 0x0020 /*UNSYNCHRONIZED*/ | 0x0004 /*INVALIDATE_RANGE*/);
+    if(p) {
+        for(int c = 0; c < 2; c++) {
+            mv_block.clip[0] = (float)c;
+            memcpy(p + c * mv_stride, &mv_block, sizeof(mv_block));
+        }
+        mv.UnmapBuffer(GL_UNIFORM_BUFFER_);
+    }
+    mv_bind_slot(clip);
+}
+
+void mv_program_linked(GLuint glprog)
+{
+    if(!gl4es_mv) return;
+    GLuint i = mv.GetUniformBlockIndex(glprog, "gl4es_MV");
+    if(i != GL_INVALID_INDEX_) mv.UniformBlockBinding(glprog, i, MV_BINDING);
+}
+
+// ********* shaders *********
+static const char* mv_defines =
+    "#define texture2D texture\n"
+    "#define texture2DProj textureProj\n"
+    "#define texture2DLod textureLod\n"
+    "#define texture2DProjLod textureProjLod\n"
+    "#define textureCube texture\n"
+    "#define textureCubeLod textureLod\n"
+    "#define texture2DLodEXT textureLod\n"
+    "#define texture2DProjLodEXT textureProjLod\n"
+    "#define textureCubeLodEXT textureLod\n"
+    "#define texture2DGradEXT textureGrad\n"
+    "#define texture3D texture\n"
+    // GLSL 1.20's shadow lookups gave a vec4; ES 3.00's give the float
+    "#define shadow2D(s, c) vec4(texture(s, c))\n"
+    "#define shadow2DProj(s, c) vec4(textureProj(s, c))\n"
+    "#define gl4es_layer float(gl_ViewID_OVR)\n";
+
+// extensions ES 3.00 has built in, or that no longer apply
+static const char* mv_dropped[] = {
+    "GL_OES_standard_derivatives", "GL_EXT_shader_texture_lod", "GL_EXT_frag_depth",
+    "GL_EXT_draw_buffers", "GL_OES_texture_3D", "GL_ARB_texture_rectangle", NULL
+};
+
+typedef struct { char* p; int n, cap; } mvbuf;
+static void put(mvbuf* b, const char* s, int n)
+{
+    if(n < 0) n = strlen(s);
+    if(b->n + n + 1 > b->cap) { b->cap = (b->n + n + 1) * 2; b->p = realloc(b->p, b->cap); }
+    memcpy(b->p + b->n, s, n); b->n += n; b->p[b->n] = 0;
+}
+
+char* mv_convert_shader(const char* src, int vertex)
+{
+    // the body, without its #version line and with words renamed
+    const char* body = src;
+    if(!strncmp(body, "#version", 8)) { body = strchr(body, '\n'); body = body ? body + 1 : ""; }
+    int cap = strlen(body) * 2 + 256;
+    char* t = malloc(cap);
+    strcpy(t, body);
+    t = gl4es_inplace_replace_simple(t, &cap, "gl_FragData[0]", "gl4es_FragColor");
+    t = gl4es_inplace_replace(t, &cap, "gl_FragColor", "gl4es_FragColor");
+    t = gl4es_inplace_replace(t, &cap, "gl_FragDepthEXT", "gl_FragDepth");
+    if(vertex) t = gl4es_inplace_replace(t, &cap, "main", "gl4es_vmain");
+    // gl_Position is written once, at the end: some drivers make a poor job
+    // of a per-view position written inside the shader's own loops
+    if(vertex) t = gl4es_inplace_replace(t, &cap, "gl_Position", "gl4es_Pos");
+    int own = vertex && strstr(t, "u_reproj") != NULL;
+
+    mvbuf o = {0};
+    put(&o, "#version 300 es\n#extension GL_OVR_multiview2 : require\n", -1);
+    static int noclip = -1;
+    if(noclip < 0) { const char* v = getenv("LIBGL_MV_NOCLIP"); noclip = v && *v == '1'; }
+    if(vertex && !noclip) put(&o, "#extension GL_EXT_clip_cull_distance : require\n", -1);
+    put(&o, vertex ? "#define attribute in\n#define varying out\n" : "#define varying in\n", -1);
+    put(&o, mv_defines, -1);
+    // the preprocessor lines at the top stay there; declarations go after them
+    char* l = t;
+    while(*l) {
+        char* e = strchr(l, '\n');
+        int n = e ? (int)(e - l + 1) : (int)strlen(l);
+        const char* s = l;
+        while(s < l + n && (*s == ' ' || *s == '\t')) s++;
+        if(s < l + n && *s != '#' && *s != '\n' && *s != '\r') break;
+        int drop = 0;
+        if(!strncmp(s, "#extension", 10))
+            for(int i = 0; mv_dropped[i]; i++) if(strstr(s, mv_dropped[i]) && strstr(s, mv_dropped[i]) < l + n) drop = 1;
+        if(!drop) put(&o, l, n);
+        l += n;
+    }
+    put(&o, "precision highp sampler2DArray;\n", -1);
+    if(strstr(t, "sampler2DShadow")) put(&o, "precision highp sampler2DShadow;\n", -1);
+    if(vertex)
+        put(&o, "layout(num_views=2) in;\n"
+                "layout(std140) uniform gl4es_MV { highp mat4 gl4es_mvR[2]; highp mat4 gl4es_mvG; highp vec4 gl4es_mvClip; };\n"
+                "highp vec4 gl4es_mvPre;\nhighp vec4 gl4es_Pos;\n", -1);
+    else if(strstr(t, "gl4es_FragColor"))
+        put(&o, "out mediump vec4 gl4es_FragColor;\n", -1);
+    put(&o, l, -1);
+    if(vertex) {
+        put(&o, "\nvoid main() {\n  gl4es_vmain();\n", -1);
+        if(own) put(&o, "  highp vec4 p = gl4es_mvPre;\n  gl_Position = gl4es_Pos;\n", -1);
+        else    put(&o, "  highp vec4 p = gl4es_mvG * gl4es_Pos;\n  gl_Position = gl4es_mvR[gl_ViewID_OVR] * gl4es_Pos;\n", -1);
+        if(!noclip)
+            put(&o, "  if(gl4es_mvClip.x == 0.0) p = vec4(0.0, 0.0, 0.0, 1.0);\n"
+                    "  gl_ClipDistance[0] = p.w - p.x;\n  gl_ClipDistance[1] = p.w + p.x;\n"
+                    "  gl_ClipDistance[2] = p.w - p.y;\n  gl_ClipDistance[3] = p.w + p.y;\n", -1);
+        put(&o, "}\n", -1);
+    }
+    free(t);
+    if(mv_dump) {
+        static int n;
+        char path[512];
+        snprintf(path, sizeof(path), "%s/%04d.%s", mv_dump, n++, vertex ? "vert" : "frag");
+        FILE* f = fopen(path, "w");
+        if(f) { fputs(o.p, f); fclose(f); }
+    }
+    return o.p;
+}
+
+// ********* rectangle textures as two-layer arrays *********
+static GLuint mv_bound[MV_UNITS];   // GL_TEXTURE_2D_ARRAY on each unit, as the driver has it
+
+// gl4es' record of the active unit is not always the driver's (some of its
+// paths switch units behind it), so the unit is chosen here explicitly and
+// the driver's own is put back
+static void bind_array(int unit, GLuint a)
+{
+    if(mv_bound[unit] == a) return;
+    GLint was = GL_TEXTURE0;
+    mv.GetIntegerv(GL_ACTIVE_TEXTURE, &was);
+    if(was != GL_TEXTURE0 + unit) mv.ActiveTexture(GL_TEXTURE0 + unit);
+    mv.BindTexture(GL_TEXTURE_2D_ARRAY_, a);
+    mv_bound[unit] = a;
+    if(was != GL_TEXTURE0 + unit) mv.ActiveTexture(was);
+}
+
+static int is_depth(gltexture_t* tex)
+{
+    return tex->format == GL_DEPTH_COMPONENT || tex->format == GL_DEPTH_STENCIL;
+}
+
+static GLuint array_for(gltexture_t* tex)
+{
+    int w = tex->nwidth ? tex->nwidth : tex->width, h = tex->nheight ? tex->nheight : tex->height;
+    if(tex->mvarray && tex->mv_w == w && tex->mv_h == h) return tex->mvarray;
+    if(tex->mvarray) {
+        for(int u = 0; u < MV_UNITS; u++) if(mv_bound[u] == tex->mvarray) mv_bound[u] = 0;
+        mv.DeleteTextures(1, &tex->mvarray);
+    }
+    GLuint a = 0;
+    mv.GenTextures(1, &a);
+    GLint act = GL_TEXTURE0;
+    mv.GetIntegerv(GL_ACTIVE_TEXTURE, &act);
+    int unit = act - GL_TEXTURE0;
+    GLuint prev = mv_bound[unit];
+    bind_array(unit, a);
+    // a half-float target (an HDR scene) keeps its range in both layers
+    mv.TexStorage3D(GL_TEXTURE_2D_ARRAY_, 1, is_depth(tex) ? GL_DEPTH24_STENCIL8_ :
+                    (tex->type == GL_HALF_FLOAT_OES || tex->type == 0x140B || tex->type == GL_FLOAT) ? 0x881A /* RGBA16F */ : GL_RGBA8_, w, h, 2);
+    bind_array(unit, prev);
+    tex->mvarray = a; tex->mv_w = w; tex->mv_h = h;
+    tex->mv_min = tex->mv_mag = tex->mv_ws = tex->mv_wt = 0;
+    return a;
+}
+
+// A 2D texture drawn into is drawn in both layers of its array too, and
+// sampled as the 2D texture it is: what the first view drew is copied into it
+// when its framebuffer is left. (The game draws menu models this way, into
+// textures it then shows as sprites.)
+#define MV_COPIES 64
+static struct { GLuint fb; GLenum attachment; gltexture_t* tex; } mv_copy[MV_COPIES];
+
+void mv_framebuffer_left(GLuint fb)
+{
+    static GLuint rd, dr;
+    int any = 0;
+    for(int i = 0; i < MV_COPIES; i++) {
+        gltexture_t* t = mv_copy[i].tex;
+        if(!t || mv_copy[i].fb != fb || !t->mvarray) continue;
+        // a blit: the texture may not be complete yet, which glCopyImageSubData needs
+        if(!any) {
+            any = 1;
+            if(!rd) { mv.GenFramebuffers(1, &rd); mv.GenFramebuffers(1, &dr); }
+            mv.BindFramebuffer(GL_READ_FRAMEBUFFER, rd);
+            mv.BindFramebuffer(GL_DRAW_FRAMEBUFFER, dr);
+        }
+        // depth goes as depth and stencil, the format both sides have
+        int depth = mv_copy[i].attachment != GL_COLOR_ATTACHMENT0;
+        GLenum at = depth ? GL_DEPTH_STENCIL_ATTACHMENT : GL_COLOR_ATTACHMENT0;
+        GLenum other = depth ? GL_COLOR_ATTACHMENT0 : GL_DEPTH_STENCIL_ATTACHMENT;
+        mv.FramebufferTexture2D(GL_READ_FRAMEBUFFER, other, GL_TEXTURE_2D, 0, 0);
+        mv.FramebufferTexture2D(GL_DRAW_FRAMEBUFFER, other, GL_TEXTURE_2D, 0, 0);
+        mv.FramebufferTextureLayer(GL_READ_FRAMEBUFFER, at, t->mvarray, 0, 0);
+        mv.FramebufferTexture2D(GL_DRAW_FRAMEBUFFER, at, GL_TEXTURE_2D, t->glname, 0);
+        GLboolean sc = mv.IsEnabled(GL_SCISSOR_TEST);
+        if(sc) mv.Disable(GL_SCISSOR_TEST);
+        mv.BlitFramebuffer(0, 0, t->mv_w, t->mv_h, 0, 0, t->mv_w, t->mv_h,
+                           depth ? GL_DEPTH_BUFFER_BIT | GL_STENCIL_BUFFER_BIT : GL_COLOR_BUFFER_BIT, GL_NEAREST);
+        if(sc) mv.Enable(GL_SCISSOR_TEST);
+        if(mv_check) {
+            static int shown;
+            GLenum e = mv.GetError();
+            if(e && shown++ < 10) printf("LIBGL: multiview: copying texture %u (%dx%d) back: error %#x (type %#x format %#x internal %#x, %s)\n", t->texture, t->mv_w, t->mv_h, e, t->type, t->format, t->internalformat, depth ? "depth" : "colour");
+        }
+    }
+    if(any) {   // as gl4es had it
+        mv.BindFramebuffer(GL_FRAMEBUFFER, fb ? fb : glstate->fbo.mainfbo_fbo);
+    }
+}
+
+// A rectangle texture given its pixels (a lookup table, say, not a render
+// target): the same pixels in both layers.
+void mv_upload(gltexture_t* tex, int x, int y, int w, int h, GLenum format, GLenum type, const void* pixels, int whole)
+{
+    // made without pixels (a movie's frames, a render target) it still gets
+    // its layers, for what is given later; depth ones get theirs attached
+    static int noempty = -1;
+    if(noempty < 0) { const char* v = getenv("LIBGL_MV_NOEMPTY"); noempty = v && *v == '1'; }
+    if(!gl4es_mv || !tex || (!pixels && (!whole || is_depth(tex) || noempty))) return;
+    if(whole && mv_check) printf("LIBGL: multiview: rectangle texture %u given pixels, %dx%d, format %#x type %#x\n", tex->texture, w, h, format, type);
+    GLint act = GL_TEXTURE0;
+    mv.GetIntegerv(GL_ACTIVE_TEXTURE, &act);
+    int unit = act - GL_TEXTURE0;
+    GLuint prev = mv_bound[unit];
+    if(whole) {
+        if(tex->mvarray) {
+            for(int u = 0; u < MV_UNITS; u++) if(mv_bound[u] == tex->mvarray) mv_bound[u] = 0;
+            mv.DeleteTextures(1, &tex->mvarray);
+            if(prev == tex->mvarray) prev = 0;
+        }
+        mv.GenTextures(1, &tex->mvarray);
+        bind_array(unit, tex->mvarray);
+        mv.TexImage3D(GL_TEXTURE_2D_ARRAY_, 0, format, tex->nwidth, tex->nheight, 2, 0, format, type, NULL);
+        tex->mv_w = tex->nwidth; tex->mv_h = tex->nheight;
+        tex->mv_min = tex->mv_mag = tex->mv_ws = tex->mv_wt = 0;
+    } else {
+        if(!tex->mvarray) return;
+        bind_array(unit, tex->mvarray);
+    }
+    if(pixels)
+        for(int l = 0; l < 2; l++) mv.TexSubImage3D(GL_TEXTURE_2D_ARRAY_, 0, x, y, l, w, h, 1, format, type, pixels);
+    bind_array(unit, prev);
+}
+
+int mv_attach(GLenum target, GLenum attachment, gltexture_t* tex, GLuint fb, GLenum textarget)
+{
+    if(!gl4es_mv || !tex) return 0;
+    // depth too: a game samples its scene's depth (fog) and its shadow maps
+    if(textarget == GL_TEXTURE_2D && attachment != GL_STENCIL_ATTACHMENT) {
+        int k = -1;
+        for(int i = 0; i < MV_COPIES; i++)
+            if(mv_copy[i].tex && mv_copy[i].fb == fb && mv_copy[i].attachment == attachment) { k = i; break; }
+        for(int i = 0; k < 0 && i < MV_COPIES; i++) if(!mv_copy[i].tex) k = i;
+        if(k < 0) { printf("LIBGL: multiview: too many 2D textures drawn into\n"); return 0; }
+        mv_copy[k].fb = fb; mv_copy[k].attachment = attachment; mv_copy[k].tex = tex;
+    }
+    // a depth array has stencil too: the eyes' framebuffer is drawn with it
+    if(attachment == GL_DEPTH_ATTACHMENT && is_depth(tex)) attachment = GL_DEPTH_STENCIL_ATTACHMENT;
+    mv.FramebufferTextureMultiviewOVR(target, attachment, array_for(tex), 0, 0, 2);
+    return 1;
+}
+
+// A 2D texture drawn into in both views and read back per view: a game's
+// world drawn offscreen and then composited onto the eyes. Programs sample it
+// as a sampler2DArray at the view's layer; its array is bound on the unit.
+void gl4es_multiview_layered(GLuint texture)
+{
+    gltexture_t* tex = gl4es_getTexture(GL_TEXTURE_2D, texture);
+    if(tex) tex->mv_layered = 1;
+}
+
+GLuint gl4es_multiview_array(GLuint texture)
+{
+    gltexture_t* tex = gl4es_getTexture(GL_TEXTURE_RECTANGLE_ARB, texture);
+    return tex ? tex->mvarray : 0;
+}
+
+static GLenum no_mip(GLenum f)
+{
+    return (f == GL_NEAREST || f == GL_NEAREST_MIPMAP_NEAREST || f == GL_NEAREST_MIPMAP_LINEAR) ? GL_NEAREST : GL_LINEAR;
+}
+static GLenum edge(GLenum w)
+{
+    return (w == GL_REPEAT || w == GL_MIRRORED_REPEAT) ? w : GL_CLAMP_TO_EDGE;
+}
+
+// before a draw: each unit's rectangle texture's array, with its filters
+void mv_realize_arrays(void)
+{
+    if(mv_check < 0) { const char* v = getenv("LIBGL_MV_CHECK"); mv_check = v && *v == '1'; }
+    if(mv_check) {
+        static int n, shown;
+        GLenum e = mv.GetError();
+        n++;
+        if(e && shown < 40) { shown++; printf("LIBGL: multiview: GL error %#x before draw %d (program %u)\n", e, n, glstate->gleshard->program); }
+        static GLboolean (*isen)(GLenum);
+        if(!isen) *(void**)&isen = proc_address(gles, "glIsEnabled");
+        int on = 0;
+        for(int i = 0; i < 4; i++) on |= isen(GL_CLIP_DISTANCE0_ + i) << i;
+        static int cshown;
+        if(on && !mv_clip && cshown < 20) { cshown++; printf("LIBGL: multiview: clip distances %#x on at draw %d, not asked for\n", on, n); }
+    }
+    int n = hardext.maxtex < MV_UNITS ? hardext.maxtex : MV_UNITS;
+    for(int u = 0; u < n; u++) {
+        gltexture_t* tex = glstate->texture.bound[u][ENABLED_TEXTURE_RECTANGLE];
+        if(!(tex && tex->mvarray)) {     // else a layered 2D target on the unit
+            gltexture_t* t2 = glstate->texture.bound[u][ENABLED_TEX2D];
+            if(t2 && t2->mv_layered && t2->mvarray) tex = t2;
+        }
+        GLuint a = tex ? tex->mvarray : 0;
+        GLuint had = mv_bound[u];
+        if(mv_bound[u] != a) bind_array(u, a);
+        if(gl4es_mv_trace && u < 4) {
+            GLint was = 0, real = 0;
+            mv.GetIntegerv(GL_ACTIVE_TEXTURE, &was);
+            mv.ActiveTexture(GL_TEXTURE0 + u);
+            mv.GetIntegerv(0x8C1D, &real);
+            mv.ActiveTexture(was);
+            printf("LIBGL: multiview: unit %d: rect texture %u, array %u (cache had %u), driver has %d, active %#x, maxtex %d\n",
+                   u, tex ? tex->texture : 0, a, had, real, was, hardext.maxtex);
+        }
+        if(!a) continue;
+        // what gl4es gave the texture itself (realize_1texture, just before)
+        glsampler_t* s = tex->actual.wrap_s ? &tex->actual : &tex->sampler;
+        GLenum mn = is_depth(tex) ? GL_NEAREST : no_mip(s->min_filter ? s->min_filter : GL_LINEAR);
+        GLenum mg = is_depth(tex) ? GL_NEAREST : no_mip(s->mag_filter ? s->mag_filter : GL_LINEAR);
+        GLenum ws = edge(s->wrap_s), wt = edge(s->wrap_t);
+        if(mv_check && tex->texture && !tex->mv_ws)
+            printf("LIBGL: multiview: texture %u: min %#x mag %#x wrap %#x %#x (set %#x %#x)\n", tex->texture, mn, mg, ws, wt, tex->sampler.wrap_s, tex->sampler.wrap_t);
+        if(mn == tex->mv_min && mg == tex->mv_mag && ws == tex->mv_ws && wt == tex->mv_wt) continue;
+        GLint was = GL_TEXTURE0;
+        mv.GetIntegerv(GL_ACTIVE_TEXTURE, &was);
+        mv.ActiveTexture(GL_TEXTURE0 + u);
+        mv.TexParameteri(GL_TEXTURE_2D_ARRAY_, GL_TEXTURE_MIN_FILTER, mn);
+        mv.TexParameteri(GL_TEXTURE_2D_ARRAY_, GL_TEXTURE_MAG_FILTER, mg);
+        mv.TexParameteri(GL_TEXTURE_2D_ARRAY_, GL_TEXTURE_WRAP_S, ws);
+        mv.TexParameteri(GL_TEXTURE_2D_ARRAY_, GL_TEXTURE_WRAP_T, wt);
+        mv.ActiveTexture(was);
+        tex->mv_min = mn; tex->mv_mag = mg; tex->mv_ws = ws; tex->mv_wt = wt;
+    }
+}
+
+// For finding what goes wrong: one layer of a texture's array, as RGBA bytes
+// (w*h*4 of them). Returns 0 if it has none.
+int gl4es_multiview_read(GLuint texture, GLenum target, int layer, void* out)
+{
+    gltexture_t* tex = gl4es_getTexture(target, texture);
+    if(!gl4es_mv || !tex || !tex->mvarray || is_depth(tex)) return 0;
+    GLuint fb = 0;
+    mv.GenFramebuffers(1, &fb);
+    mv.BindFramebuffer(GL_READ_FRAMEBUFFER, fb);
+    mv.FramebufferTextureLayer(GL_READ_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, tex->mvarray, 0, layer);
+    mv.ReadPixels(0, 0, tex->mv_w, tex->mv_h, GL_RGBA, GL_UNSIGNED_BYTE, out);
+    mv.BindFramebuffer(GL_READ_FRAMEBUFFER, glstate->fbo.current_fb ? glstate->fbo.current_fb->id : 0);
+    mv.DeleteFramebuffers(1, &fb);
+    return 1;
+}
+
+// A region of one view's layer of a rectangle texture (the eye image), scaled
+// into a region of a GL_TEXTURE_2D: what glCopyTexSubImage2D from the window
+// means when the window is the eyes. Linear filtering, as the region shrinks.
+int gl4es_multiview_copy(GLuint src, int layer, int sx0, int sy0, int sx1, int sy1,
+                         GLuint dst, int level, int dx0, int dy0, int dx1, int dy1)
+{
+    gltexture_t* s = gl4es_getTexture(GL_TEXTURE_RECTANGLE_ARB, src);
+    gltexture_t* d = gl4es_getTexture(GL_TEXTURE_2D, dst);
+    if(!gl4es_mv || !s || !s->mvarray || !d || !d->glname) return 0;
+    GLuint fb[2] = {0, 0};
+    GLint read = 0, draw = 0;
+    mv.GetIntegerv(0x8CAA /*GL_READ_FRAMEBUFFER_BINDING*/, &read);
+    mv.GetIntegerv(0x8CA6 /*GL_DRAW_FRAMEBUFFER_BINDING*/, &draw);
+    mv.GenFramebuffers(2, fb);
+    mv.BindFramebuffer(GL_READ_FRAMEBUFFER, fb[0]);
+    mv.FramebufferTextureLayer(GL_READ_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, s->mvarray, 0, layer);
+    mv.BindFramebuffer(GL_DRAW_FRAMEBUFFER, fb[1]);
+    mv.FramebufferTexture2D(GL_DRAW_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, d->glname, level);
+    int scissor = mv.IsEnabled(GL_SCISSOR_TEST);
+    if(scissor) mv.Disable(GL_SCISSOR_TEST);
+    mv.BlitFramebuffer(sx0, sy0, sx1, sy1, dx0, dy0, dx1, dy1, GL_COLOR_BUFFER_BIT, GL_LINEAR);
+    if(scissor) mv.Enable(GL_SCISSOR_TEST);
+    mv.BindFramebuffer(GL_READ_FRAMEBUFFER, read);
+    mv.BindFramebuffer(GL_DRAW_FRAMEBUFFER, draw);
+    mv.DeleteFramebuffers(2, fb);
+    return 1;
+}
+
+// one pixel of the first view's layer of what is being drawn into
+void gl4es_multiview_read_pixel_layer(int x, int y, int layer, unsigned char out[4]);
+void gl4es_multiview_read_pixel(int x, int y, unsigned char out[4])
+{
+    gl4es_multiview_read_pixel_layer(x, y, 0, out);
+}
+void gl4es_multiview_read_pixel_layer(int x, int y, int layer, unsigned char out[4])
+{
+    static void (*attr)(GLenum, GLenum, GLenum, GLint*);
+    if(!attr) *(void**)&attr = proc_address(gles, "glGetFramebufferAttachmentParameteriv");
+    GLint draw = 0, obj = 0;
+    mv.GetIntegerv(0x8CA6 /*GL_DRAW_FRAMEBUFFER_BINDING*/, &draw);
+    attr(0x8CA9 /*GL_DRAW_FRAMEBUFFER*/, GL_COLOR_ATTACHMENT0, 0x8CD1 /*GL_FRAMEBUFFER_ATTACHMENT_OBJECT_NAME*/, &obj);
+    out[0] = out[1] = out[2] = out[3] = 0;
+    if(!obj) return;
+    GLuint fb = 0;
+    mv.GenFramebuffers(1, &fb);
+    mv.BindFramebuffer(GL_READ_FRAMEBUFFER, fb);
+    mv.FramebufferTextureLayer(GL_READ_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, obj, 0, layer);
+    mv.ReadPixels(x, y, 1, 1, GL_RGBA, GL_UNSIGNED_BYTE, out);
+    mv.BindFramebuffer(GL_READ_FRAMEBUFFER, draw);
+    mv.DeleteFramebuffers(1, &fb);
+}
+
+// time spent per draw in gl4es' stages, for the host's profiler (ns):
+// textures, program and uniforms, the driver's draw
+double gl4es_drawprof[4];
+int gl4es_drawprof_on;
+double gl4es_now_ns(void) { struct timespec t; clock_gettime(CLOCK_MONOTONIC, &t); return t.tv_sec * 1e9 + t.tv_nsec; }
+double gl4es_bufprof_copy, gl4es_bufprof_bytes;
